  @@index([dispatchId, createdAt])
}

enum StockMovementType {
  OPENING_STOCK
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  TRANSFER_IN
  TRANSFER_OUT
}

model StockLedger {
  id              String            @id @default(cuid())
  productId       String
  warehouseId     String
  movementType    StockMovementType
  quantity        Int
  reference       String?
  reason          String?
  notes           String?
  transferGroupId String?
  createdById     String            @db.Uuid
  product         Product           @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  warehouse       Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy       User              @relation(fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt       DateTime          @default(now())

  @@index([productId, createdAt])
  @@index([warehouseId, createdAt])
  @@index([movementType, createdAt])
  @@index([createdById])
  @@index([transferGroupId])
}
