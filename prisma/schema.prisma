  warehouse        Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([productId, warehouseId])
  @@index([warehouseId])
  @@index([productId])
}

model SalesOrder {
  id                       String                  @id @default(cuid())
  orderNumber              String                  @unique
  quotationId              String                  @unique
  customerId               String
  createdById              String                  @db.Uuid
  assignedSalesExecutiveId String?                 @db.Uuid
  status                   SalesOrderStatus        @default(DRAFT)
  orderDate                DateTime                @default(now())
  convertedAt              DateTime                @default(now())
  deliveryAddress          String?
  deliveryCity             String?
  deliveryState            String?
  deliveryPincode          String?
  deliveryContactName      String?
  deliveryContactPhone     String?
  deliveryInstructions     String?
  notes                    String?
  subtotal                 Decimal                 @db.Decimal(12, 2)
  discountAmount           Decimal                 @db.Decimal(12, 2)
  taxableAmount            Decimal                 @db.Decimal(12, 2)
  taxAmount                Decimal                 @db.Decimal(12, 2)
  totalAmount              Decimal                 @db.Decimal(12, 2)
  currency                 String                  @default("INR")
  cancellationReason       String?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  quotation                Quotation               @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  customer                 Customer                @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy                User                    @relation("SalesOrderCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignedSalesExecutive   User?                   @relation("SalesOrderAssignee", fields: [assignedSalesExecutiveId], references: [id], onDelete: SetNull)
  items                    SalesOrderItem[]
  events                   SalesOrderEvent[]
  reservations             SalesOrderReservation[]
  pickingList              PickingList?
  packingRecords           PackingRecord[]
  dispatches               Dispatch[]
  invoices                 Invoice[]

  @@index([status, orderDate])
  @@index([customerId, orderDate])
  @@index([assignedSalesExecutiveId, orderDate])
}

model SalesOrderItem {
  id                       String                  @id @default(cuid())
  salesOrderId             String
  productId                String?
  productNameSnapshot      String
  skuSnapshot              String
  quantity                 Int
  unitPrice                Decimal                 @db.Decimal(12, 2)
  catalogUnitPriceSnapshot Decimal?                @db.Decimal(12, 2)
  discount                 Decimal                 @db.Decimal(12, 2)
  taxRate                  Decimal                 @db.Decimal(5, 2)
  taxAmount                Decimal                 @db.Decimal(12, 2)
  lineTotal                Decimal                 @db.Decimal(12, 2)
  salesOrder               SalesOrder              @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product                  Product?                @relation(fields: [productId], references: [id], onDelete: SetNull)
  reservations             SalesOrderReservation[]
  pickingItem              PickingListItem?
  packageItems             PackageItem[]
