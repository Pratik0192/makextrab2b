  packageItem   PackageItem @relation(fields: [packageItemId], references: [id], onDelete: Restrict)

  @@unique([dispatchId, packageItemId])
  @@index([packageItemId])
}

model Invoice {
  id                    String                   @id @default(cuid())
  invoiceNumber         String?                  @unique
  status                InvoiceStatus            @default(DRAFT)
  paymentStatus         InvoicePaymentStatus     @default(UNPAID)
  invoiceDate           DateTime?
  dueDate               DateTime?
  customerId            String
  salesOrderId          String
  quotationId           String
  dispatchId            String                   @unique
  financialYearId       String?
  numberingConfigId     String?
  createdById           String                   @db.Uuid
  issuedById            String?                  @db.Uuid
  issuedAt              DateTime?
  cancelledById         String?                  @db.Uuid
  cancelledAt           DateTime?
  cancellationReason    String?
  supplyTreatment       String
  placeOfSupply         String?
  stateCode             String?
  reverseCharge         Boolean                  @default(false)
  companySnapshot       Json
  customerSnapshot      Json
  shippingSnapshot      Json
  chargesSnapshot       Json
  taxableSubtotal       Decimal                  @db.Decimal(14, 2)
  cgstTotal             Decimal                  @db.Decimal(14, 2)
  sgstTotal             Decimal                  @db.Decimal(14, 2)
  igstTotal             Decimal                  @db.Decimal(14, 2)
  cessTotal             Decimal                  @db.Decimal(14, 2)
  freightTotal          Decimal                  @default(0) @db.Decimal(14, 2)
  packingTotal          Decimal                  @default(0) @db.Decimal(14, 2)
  otherChargesTotal     Decimal                  @default(0) @db.Decimal(14, 2)
  discountTotal         Decimal                  @default(0) @db.Decimal(14, 2)
  roundOff              Decimal                  @default(0) @db.Decimal(14, 2)
  grandTotal            Decimal                  @db.Decimal(14, 2)
  amountPaid            Decimal                  @default(0) @db.Decimal(14, 2)
  amountCredited        Decimal                  @default(0) @db.Decimal(14, 2)
  customerCreditBalance Decimal                  @default(0) @db.Decimal(14, 2)
  outstandingAmount     Decimal                  @db.Decimal(14, 2)
  pdfProviderFileId     String?
  pdfGeneratedAt        DateTime?
  pdfVersion            Int                      @default(0)
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  customer              Customer                 @relation(fields: [customerId], references: [id], onDelete: Restrict)
  salesOrder            SalesOrder               @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  quotation             Quotation                @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  dispatch              Dispatch                 @relation(fields: [dispatchId], references: [id], onDelete: Restrict)
  financialYear         FinancialYear?           @relation(fields: [financialYearId], references: [id], onDelete: Restrict)
  numberingConfig       DocumentNumberingConfig? @relation(fields: [numberingConfigId], references: [id], onDelete: Restrict)
  createdBy             User                     @relation("InvoiceCreator", fields: [createdById], references: [id], onDelete: Restrict)
  issuedBy              User?                    @relation("InvoiceIssuer", fields: [issuedById], references: [id], onDelete: Restrict)
  cancelledBy           User?                    @relation("InvoiceCanceller", fields: [cancelledById], references: [id], onDelete: Restrict)
  items                 InvoiceItem[]
  events                InvoiceEvent[]
  documents             InvoiceDocument[]
  payments              InvoicePayment[]
  creditNotes           CreditNote[]

  @@index([customerId, invoiceDate])
  @@index([salesOrderId, createdAt])
  @@index([status, paymentStatus, invoiceDate])
  @@index([dueDate, paymentStatus])
  @@index([createdById, createdAt])
}

