  @@index([salesOrderId, status, createdAt])
  @@index([warehouseId, dispatchedAt])
  @@index([deliveryStatus, dispatchedAt])
}

model DispatchItem {
  id            String      @id @default(cuid())
  dispatchId    String
  packageItemId String
