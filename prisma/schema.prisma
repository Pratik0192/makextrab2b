  taxRate                  Decimal   @default(0) @db.Decimal(5, 2)
  taxAmount                Decimal   @default(0) @db.Decimal(12, 2)
  lineTotal                Decimal   @db.Decimal(12, 2)
  quotation                Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product                  Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([quotationId])
  @@index([productId])
}

model QuotationEvent {
  id          String    @id @default(cuid())
  quotationId String
  actorId     String    @db.Uuid
  action      String
  details     Json?
  createdAt   DateTime  @default(now())
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  actor       User      @relation("QuotationEventActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([quotationId, createdAt])
}

model Warehouse {
  id             String                  @id @default(cuid())
  name           String
  code           String                  @unique
  description    String?
  address        String?
  city           String?
  state          String?
  pincode        String?
  contactPerson  String?
  contactPhone   String?
  isActive       Boolean                 @default(true)
  stockBalances  StockBalance[]
  stockLedger    StockLedger[]
