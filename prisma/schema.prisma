  @@index([salesOrderId])
  @@index([productId])
}

model SalesOrderEvent {
  id           String     @id @default(cuid())
  salesOrderId String
  actorId      String     @db.Uuid
  action       String
  details      Json?
  createdAt    DateTime   @default(now())
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  actor        User       @relation("SalesOrderEventActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([salesOrderId, createdAt])
  @@index([actorId, createdAt])
}

model SalesOrderReservation {
  id               String            @id @default(cuid())
